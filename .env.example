# Copy this file to .env and fill in your Supabase project's values.
# Find both on your project's dashboard: Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile site key (public, safe to expose client-side).
# The secret key is never used in this app — it lives only in Supabase's
# Auth > Attack Protection settings.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
